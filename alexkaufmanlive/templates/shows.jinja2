{% extends "base.jinja2" %}
{% import "parts.jinja2" as parts %}
{% block canonical -%}
    {%- if page > 1 -%}
        <link rel="canonical" href="{{ url_for('shows.index', page=page, _external=True) }}" />
    {%- else -%}
        <link rel="canonical" href="{{ url_for('shows.index', _external=True) }}" />
    {%- endif -%}
{%- endblock %}
{% block main %}

    {% if not has_prev %}
    <h1> Upcoming Shows </h1>
    {{ parts.show_list(upcoming_shows) }}
    {% endif %}

    <h1> Past Shows {% if has_prev %}(page {{page}}){% endif %} </h1>
    {{ parts.show_list(past_shows) }}

    {%- if has_prev or has_next -%}
    <div class="pagination">
        <div>
        {%- if has_prev -%}
            <a href="{{ url_for('shows.index', page=page-1) }}" class="pagination-prev">← Previous</a>
        {%- endif -%}
        </div>
        <div>
        {%- if has_next -%}
            <a href="{{ url_for('shows.index', page=page+1) }}" class="pagination-next">Next →</a>
        {%- endif -%}
        </div>
    </div>
    {%- endif -%}
{% endblock %}
