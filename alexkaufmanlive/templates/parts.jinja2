{%- macro show_list(shows) -%}
<ul class="show-list">
{%- if not shows -%}
    <p>
        No upcoming shows right now.
        <a href="mailto:alexkaufmancomedy@gmail.com">
            Reach out and change that.
        </a>
    </p>
{%- endif -%}
{%- for show in shows -%}
    <li>
    <article class="show on-list">
        <h2 class="show-title">
            <a href="{{ url_for('shows.show', show_slug=show.link) }}">
                {{ show.title }}
            </a>
        </h2>
        <div class="show-meta">
            <div class="location">
            {%- if show.meta -%}
                {{ show["meta"]["city"] }}, {{ show["meta"]["state"]}}
            {%- endif -%}
            </div>
            <time class="show-date">{{ show["show_date"] | displaydate }}</time>
        </div>
    </article>
    </li>
{%- endfor -%}
</ul>
{%- endmacro %}

{#- Video clip — a clickable thumbnail that links out to the video.
    `thumb` is a local image in static/originals/; it runs through the
    same responsive <picture> pipeline as the photos. Renders identically
    on the website and in the EPK PDF (the only difference is CSS). Wrap
    the calls in a <div class="video-clips"> in the markdown to lay them
    side by side.

    Output mirrors the photo-gallery markup: a <figure> with blank lines
    around the markdown image so the renderer rewrites it into a linked
    responsive <picture>, plus a <figcaption> for the title. -#}
{% macro clip(url, title, thumb) -%}
<figure class="video-clip">

[![{{ title }}]({{ thumb }})]({{ url }})

<figcaption>{{ title }}</figcaption>

</figure>
{%- endmacro %}

{#- Embed a YouTube video inline. Works for Shorts too — a Short is a
    normal video, YouTube just hides the embed button. Take the 11-char id
    from the Shorts URL (youtube.com/shorts/<id>) and pass it here.

    `vertical=True` (the default) frames it 9:16 for Shorts; pass
    vertical=False for a normal 16:9 landscape video. Uses the
    nocookie host and lazy loading. Put blank lines around the call in
    markdown so it renders as its own block. -#}
{% macro youtube(video_id, title="YouTube video", vertical=True) -%}
<div class="youtube-embed{{ ' vertical' if vertical else '' }}">
<iframe src="https://www.youtube-nocookie.com/embed/{{ video_id }}" title="{{ title }}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerated-sensors; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
</div>
{%- endmacro %}

{% macro eventbrite_button() -%}
<button id="event-button" type="button">buy tickets</button>

<script src="https://www.eventbrite.com/static/widgets/eb_widgets.js"></script>

<script type="text/javascript">
    var exampleCallback = function () {
        console.log('Order complete!');
    };

    window.EBWidgets.createWidget({
        widgetType: 'checkout',
        eventId: '{{ meta.eventbrite_id }}',
        modal: true,
        modalTriggerElementId: 'event-button',
        onOrderComplete: exampleCallback,
    });
</script>
{%- endmacro %}

{% macro tickettailor_button(event_id, box_office_name) -%}
<script src="https://cdn.tickettailor.com/js/TTWidget.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var ticketButton = document.getElementById('ticketButton');
    if (ticketButton) {
        ticketButton.addEventListener('click', function() {
            var eventId = '{{ event_id }}'; // Ensure this binding pulls the correct ID
            TTWidget.loadEvent('{{ box_office_name }}', eventId);
        });
    }
});

</script>

<button id="ticketButton" type="button">buy tickets</button>
{%- endmacro %}

{% macro event_button(event_link) -%}
<a href="{{ event_link }}"><button id="event-button" type="button">buy tickets</button></a>
{%- endmacro %}


{#- The signup fields, shared by the pop-up on show and contact pages
    and the /join page. "website" is a honeypot: it is hidden from people,
    bots fill it in, and the server quietly drops any signup that has it. -#}
{% macro email_form_fields(prefix) -%}
<label for="{{ prefix }}-name">Name (optional)</label>
<input type="text" name="name" id="{{ prefix }}-name" autocomplete="name" maxlength="100" />
<label for="{{ prefix }}-email">Email</label>
<input type="email" name="email" id="{{ prefix }}-email" autocomplete="email" maxlength="254" required />
<label for="{{ prefix }}-zip">Zip code (optional, so I can tell you about shows near you)</label>
<input type="text" name="zip" id="{{ prefix }}-zip" autocomplete="postal-code" maxlength="10" />
<div class="hp-field" aria-hidden="true">
<label for="{{ prefix }}-website">Leave this empty</label>
<input type="text" name="website" id="{{ prefix }}-website" tabindex="-1" autocomplete="off" />
</div>
{%- endmacro %}

{#- Wires a signup form to /api/subscribe. On a result, the contents of
    the box with id box_id are swapped for the message. When modal_id is
    given, "close" hides that modal. -#}
{% macro email_form_script(form_id, box_id, modal_id=None) -%}
<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('{{ form_id }}');
  const box = document.getElementById('{{ box_id }}');
  const modal = document.getElementById('{{ modal_id or "" }}');
  if (!form || !box) return;
  function show(title, text, label, onClick) {
    box.innerHTML = '';
    const h = document.createElement('h3');
    h.textContent = title;
    const p = document.createElement('p');
    p.textContent = text;
    const row = document.createElement('div');
    row.className = 'modal-buttons';
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = label;
    b.addEventListener('click', onClick);
    row.appendChild(b);
    box.append(h, p, row);
  }
  function retry() { location.reload(); }
  function done() {
    {% if modal_id %}modal.style.display = 'none';
    location.reload();{% else %}window.location.href = '/';{% endif %}
  }
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    fetch('{{ url_for("main.email_subscribe") }}', {
      method: 'POST',
      body: new FormData(form)
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        show('Almost there!', data.message, '{{ "close" if modal_id else "done" }}', done);
      } else {
        show('Error', data.error || 'Error subscribing. Please try again.', 'try again', retry);
      }
    })
    .catch(() => show('Error', 'Error subscribing. Please try again.', 'try again', retry));
  });
});
</script>
{%- endmacro %}

{#- Pop-up signup used on show and contact pages. -#}
{% macro email_list_cta(tags) -%}
<button type="button" id="email-signup-button">join my email list</button>
<div id="email-modal" class="modal">
  <div class="modal-content" id="email-modal-content">
    <h3>join my email list</h3>
    <form id="email-form">
      {{ email_form_fields("modal") }}
      <div class="modal-buttons">
        <button type="button" id="email-modal-close">cancel</button>
        <button type="submit" id="email-submit">join</button>
      </div>
    </form>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const button = document.getElementById('email-signup-button');
  const modal = document.getElementById('email-modal');
  const closeButton = document.getElementById('email-modal-close');
  button.addEventListener('click', function() {
    modal.style.display = 'block';
  });
  closeButton.addEventListener('click', function() {
    modal.style.display = 'none';
  });
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      modal.style.display = 'none';
    }
  });
});
</script>
{{ email_form_script("email-form", "email-modal-content", "email-modal") }}
{%- endmacro %}

{#- Home page button: goes to the /join page instead of a pop-up. -#}
{% macro email_join_link() -%}
