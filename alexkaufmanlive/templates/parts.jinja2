{%- macro show_list(shows) -%}
<ul class="show-list">
{%- if not shows -%}
    <p>
        No upcoming shows right now.
        <a href="mailto:alexkaufmancomedy@gmail.com">
            Reach out and change that.
        </a>
    </p>
{%- endif -%}
{%- for show in shows -%}
    <li>
    <article class="show on-list">
        <h2 class="show-title">
            <a href="{{ url_for('shows.show', show_slug=show.link) }}">
                {{ show.title }}
            </a>
        </h2>
        <div class="show-meta">
            <div class="location">
            {%- if show.meta -%}
                {{ show["meta"]["city"] }}, {{ show["meta"]["state"]}}
            {%- endif -%}
            </div>
            <time class="show-date">{{ show["show_date"] | displaydate(show.get("end_date")) }}</time>
        </div>
    </article>
    </li>
{%- endfor -%}
</ul>
{%- endmacro %}

{#- Embedded video clips. `youtube`/`vimeo` each take just a share URL,
    an optional title, and an optional `thumb`; they parse the video id
    (and Vimeo privacy hash) out of the URL themselves. On the website a
    clip renders as a responsive 16:9 iframe whose player shows its own
    poster thumbnail before play, so `thumb` is ignored there. In the EPK
    PDF (is_epk) iframes can't render, so it shows `thumb` as a clickable
    thumbnail (a local image in static/originals/, run through the same
    responsive <picture> pipeline as the photos) linking to the video —
    or, if no thumb is given, a plain text link. Wrap the calls in a
    <div class="video-clips"> in the markdown to lay them side by side.

    Accepted URL forms:
      youtube  https://youtu.be/<id>  |  https://www.youtube.com/watch?v=<id>
      vimeo    https://vimeo.com/<id>  |  https://vimeo.com/<id>/<hash>

    On the website each macro's output is one contiguous HTML block (no
    blank lines) so mistune treats it as raw HTML and passes it through
    untouched. The EPK thumb branch instead emits markdown image syntax
    so the renderer rewrites it into a responsive <picture>. -#}
{%- macro _video_figure(embed_src, url, title, thumb) -%}
{%- if is_epk -%}
{%- if thumb -%}
[![{{ title }}]({{ thumb }})]({{ url }})
{%- else -%}
<p><a href="{{ url }}">{{ title }}</a></p>
{%- endif -%}
{%- else -%}
<figure class="video-clip"><div class="video-embed"><iframe src="{{ embed_src }}" title="{{ title }}" loading="lazy" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><figcaption>{{ title }}</figcaption></figure>
{%- endif -%}
{%- endmacro -%}

{% macro youtube(url, title="", thumb="") -%}
{%- set vid = url.split("youtu.be/")[1].split("?")[0] if "youtu.be/" in url else url.split("v=")[1].split("&")[0] -%}
{{- _video_figure("https://www.youtube-nocookie.com/embed/" ~ vid, url, title, thumb) -}}
{%- endmacro %}

{% macro vimeo(url, title="", thumb="") -%}
{%- set segs = url.split("vimeo.com/")[1].split("?")[0].split("/") -%}
{%- set src = "https://player.vimeo.com/video/" ~ segs[0] ~ ("?h=" ~ segs[1] if segs|length > 1 else "") -%}
{{- _video_figure(src, url, title, thumb) -}}
{%- endmacro %}

{% macro eventbrite_button() -%}
<button id="event-button" type="button">buy tickets</button>

<script src="https://www.eventbrite.com/static/widgets/eb_widgets.js"></script>

<script type="text/javascript">
    var exampleCallback = function () {
        console.log('Order complete!');
    };

    window.EBWidgets.createWidget({
        widgetType: 'checkout',
        eventId: '{{ meta.eventbrite_id }}',
        modal: true,
        modalTriggerElementId: 'event-button',
        onOrderComplete: exampleCallback,
    });
</script>
{%- endmacro %}

{% macro tickettailor_button(event_id, box_office_name) -%}
<script src="https://cdn.tickettailor.com/js/TTWidget.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var ticketButton = document.getElementById('ticketButton');
    if (ticketButton) {
        ticketButton.addEventListener('click', function() {
            var eventId = '{{ event_id }}'; // Ensure this binding pulls the correct ID
            TTWidget.loadEvent('{{ box_office_name }}', eventId);
        });
    }
});

</script>

<button id="ticketButton" type="button">buy tickets</button>
{%- endmacro %}

{% macro event_button(event_link) -%}
<a href="{{ event_link }}"><button id="event-button" type="button">buy tickets</button></a>
{%- endmacro %}


{% macro email_list_cta(tags) -%}
<button type="button" id="email-signup-button">join my email list</button>

<div id="email-modal" class="modal">
  <div class="modal-content">
    <h3>join my email list</h3>
    <form id="email-form">
      <label for="modal-email">Enter your email</label>
      <input type="email" name="email" id="modal-email" required />
      <div class="modal-buttons">
        <button type="button" id="email-modal-close">cancel</button>
        <button type="submit" id="email-submit">join</button>
      </div>
    </form>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const button = document.getElementById('email-signup-button');
  const modal = document.getElementById('email-modal');
  const closeButton = document.getElementById('email-modal-close');
  const form = document.getElementById('email-form');

  button.addEventListener('click', function() {
    modal.style.display = 'block';
  });

  closeButton.addEventListener('click', function() {
    modal.style.display = 'none';
  });

  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      modal.style.display = 'none';
    }
  });

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(form);

    fetch('{{ url_for("main.email_subscribe") }}', {
      method: 'POST',
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        document.querySelector('.modal-content').innerHTML = '<h3>Success!</h3><p>' + data.message + '</p><div class="modal-buttons"><button type="button" id="email-modal-close">close</button></div>';
        document.getElementById('email-modal-close').addEventListener('click', function() {
          modal.style.display = 'none';
          location.reload();
        });
      } else {
        document.querySelector('.modal-content').innerHTML = '<h3>Error</h3><p>' + (data.error || 'Error subscribing. Please try again.') + '</p><div class="modal-buttons"><button type="button" id="email-modal-close">try again</button></div>';
        document.getElementById('email-modal-close').addEventListener('click', function() {
          location.reload();
        });
      }
    })
    .catch(error => {
      document.querySelector('.modal-content').innerHTML = '<h3>Error</h3><p>Error subscribing. Please try again.</p><div class="modal-buttons"><button type="button" id="email-modal-close">try again</button></div>';
      document.getElementById('email-modal-close').addEventListener('click', function() {
        location.reload();
      });
    });
  });
});
</script>
{%- endmacro %}
