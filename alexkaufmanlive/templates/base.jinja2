<!doctype html>
<html lang="en">
<head>
{% block head %}
    <title>{% block title %}{{ site_name }}{% endblock %}</title>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=5"
    />
    {% block canonical %}<link rel="canonical" href="{{ request.base_url }}" />{% endblock %}
    <meta
        name="description"
        content="{{ tagline }}"
    />
    {# Optional LCP hint — routes that know their hero image pass the
       preload <link> markup via a `preload` kwarg. Tells the browser to
       start fetching the hero derivative before parsing the <body>. #}
    {{ preload or "" }}
    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='style.css') }}"
    />
    <script src="https://kit.fontawesome.com/33483263d1.js" crossorigin="anonymous"></script>
    <link rel="shortcut icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20100%20100'%3E%3Ctext%20y='.9em'%20font-size='90'%3E🎤%3C/text%3E%3C/svg%3E">
    {% block jsonld -%}
    {%- for schema in (jsonld or []) %}
    <script type="application/ld+json">{{ schema | tojson }}</script>
    {%- endfor %}
    {%- endblock %}
{% endblock %}
</head>
<body class="{{ page_class }}">
    <header>
        {% block header %}
        <a class="title" href="/"><h1>{{ site_name }}</h1></a>
        <nav>
            {% block nav %}
            <p>
                <a href="/">home</a>
                <a href="/shows/">shows</a>
                <a href="/contact/">contact</a>
            </p>
            {% endblock %}
        </nav>
        {% endblock %}
    </header>
    <main>
        {% block main %}
            {{ content }}
        {% endblock %}
    </main>
    <footer>
        {% block footer %}


        <span id="footer-directive">
        <h2>
        <a href="https://facebook.com/alexkaufmanlive" aria-label="Alex Kaufman Live Facebook link"><i class="fa-brands fa-facebook" aria-hidden="true"></i></a>
        |
        <a href="https://instagram.com/alexkaufmanlive" aria-label="Alex Kaufman Live Instagram link"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
        |
        <a href="https://youtube.com/@alexkaufmanlive" aria-label="Alex Kaufman Live Youtube link"><i class="fa-brands fa-youtube" aria-hidden="true"></i></a>
        </h2>

        </span>

        {% endblock %}
        <span>
            Inspired by <a href="https://bearblog.dev">Bear ʕ•ᴥ•ʔ</a>
        </span>
    </footer>
</body>
</html>
