{% extends "base.jinja2" %}

{% block title %} {{ title }} {% endblock %}

{% block head %}
{{ super() }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Event",
  "location": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "{{ meta.city }}",
      "addressRegion": "{{ meta.state }}",
      "postalCode": "{{ meta.zip_code }}",
      "streetAddress": "{{ meta.street_address }}"
    },
    "name": "{{ meta.venue }}"
  },
  "name": "{{ title }}",
  "startDate": "{{ show_date}}",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "description": "{{ meta.description }}",
  "image": "{% if meta.image %}{{ url_for('static', filename='originals/' + meta.image) }}{% endif %}"
}
</script>
{% endblock %}

{% block main %}
    <div class='show-head'>
        <h1 class='show-title'>{{ title }}</h1>
        <div class='show-meta'>
            <div class='venue'>
                {% if meta.venue %}
                    {{ meta.venue }},
                {% endif %}
                {% if meta.city %}
                    {{ meta.city }},
                {% endif %}
                {% if meta.state %}
                    {{ meta.state }}
                {% endif %}
            </div>
            <time class='show-date'>{{ show_date }}</time>
        </div>
    </div>

    {{ content }}

{% endblock %}
