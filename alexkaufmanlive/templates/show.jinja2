{% extends "base.jinja2" %}

{% block title %} {{ title }} {% endblock %}

{% block main %}
    <div class='show-head'>
        <h1 class='show-title'>{{ title }}</h1>
        <div class='show-meta'>
            <div class='venue'>
                {% if meta.venue %}
                    {{ meta.venue }},
                {% endif %}
                {% if meta.city %}
                    {{ meta.city }},
                {% endif %}
                {% if meta.state %}
                    {{ meta.state }}
                {% endif %}
            </div>
            <time class='show-date'>{{ show_date }}</time>
        </div>
    </div>

    {{ content }}

{% endblock %}
